# Don Chambitas: plantilla general, sin credenciales reales.
# .env es local y esta ignorado por Git. No compartirlo ni incluirlo en commits.
# Android NO lee .env: conserva SUPABASE_URL y SUPABASE_ANON_KEY en
# local.properties. No modificar ese archivo al configurar la Edge Function.

# Tu proyecto Supabase (Project Settings / API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GEMINI_API_KEY no se configura en este archivo para usar la app.
# Crear la llave con tu cuenta en https://aistudio.google.com/apikey
# En tu proyecto Supabase: Edge Functions -> Secrets -> agregar secret.
# Name: GEMINI_API_KEY; Value: la llave, sin comillas. Guardar.
# La funcion ia-generar la lee del entorno de Supabase automaticamente.
# Nunca copiar esta llave a local.properties, BuildConfig ni al APK.

# Modelos Gemini en orden de intento; verificar disponibilidad en tu cuenta.
IA_MODELOS=gemini-flash-lite-latest,gemini-flash-latest

# SUPABASE_SERVICE_ROLE_KEY NO se guarda aqui: Supabase la proporciona
# al entorno alojado de la Edge Function.
# No subir este .env completo como Secrets: SUPABASE_* son variables reservadas.
# Para subir solo IA, ver supabase/functions/README.md.
